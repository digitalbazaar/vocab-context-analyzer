{
  "@context": {
    "ex": "https://example.org/v#",
    "dc": "http://purl.org/dc/terms/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "vs": "http://www.w3.org/2003/06/sw-vocab-status/ns#",
    "schema": "http://schema.org/",
    "jsonld": "http://www.w3.org/ns/json-ld#",
    "dc:date": {
      "@type": "xsd:date"
    },
    "rdfs:domain": {
      "@type": "@id"
    },
    "rdfs:range": {
      "@type": "@id"
    },
    "rdfs:seeAlso": {
      "@type": "@id"
    },
    "rdfs:subClassOf": {
      "@type": "@id"
    },
    "rdfs:subPropertyOf": {
      "@type": "@id"
    },
    "rdfs:isDefinedBy": {
      "@type": "@id"
    },
    "owl:oneOf": {
      "@container": "@list",
      "@type": "@vocab"
    },
    "owl:deprecated": {
      "@type": "xsd:boolean"
    },
    "owl:inverseOf": {
      "@type": "@vocab"
    },
    "owl:unionOf": {
      "@container": "@list",
      "@type": "@vocab"
    },
    "rdfs_classes": {
      "@reverse": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "rdfs_properties": {
      "@reverse": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "rdfs_individuals": {
      "@reverse": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "rdfs_datatypes": {
      "@reverse": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "mentioned": {
      "@reverse": "schema:mentions",
      "@type": "@id"
    }
  },
  "@id": "https://example.org/v#",
  "@type": "owl:Ontology",
  "dc:title": {
    "@value": "Multi-Class Example Vocabulary",
    "@language": "en"
  },
  "dc:description": {
    "@value": "A vocabulary with several independent classes and cross-class object properties.",
    "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
  },
  "dc:date": "1970-01-01",
  "rdfs_properties": [
    {
      "@id": "ex:writtenBy",
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "rdfs:domain": "ex:Book",
      "rdfs:range": "ex:Author",
      "rdfs:label": "written by",
      "rdfs:comment": {
        "@value": "<div>The Author who wrote the Book.</div>",
        "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
      },
      "vs:term_status": "stable",
      "mentioned": [
        {
          "@id": "https://example.org/v.context.jsonld",
          "@type": "jsonld:Context"
        }
      ]
    },
    {
      "@id": "ex:publishedBy",
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "rdfs:domain": "ex:Book",
      "rdfs:range": "ex:Publisher",
      "rdfs:label": "published by",
      "rdfs:comment": {
        "@value": "<div>The Publisher of the Book.</div>",
        "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
      },
      "vs:term_status": "stable",
      "mentioned": [
        {
          "@id": "https://example.org/v.context.jsonld",
          "@type": "jsonld:Context"
        }
      ]
    },
    {
      "@id": "ex:title",
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "rdfs:domain": "ex:Book",
      "rdfs:range": "xsd:string",
      "rdfs:label": "title",
      "rdfs:comment": {
        "@value": "<div>The title of the Book.</div>",
        "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
      },
      "vs:term_status": "stable",
      "mentioned": [
        {
          "@id": "https://example.org/v.context.jsonld",
          "@type": "jsonld:Context"
        }
      ]
    }
  ],
  "rdfs_classes": [
    {
      "@id": "ex:Book",
      "@type": "rdfs:Class",
      "rdfs:label": "Book",
      "rdfs:comment": {
        "@value": "<div>A written work.</div>",
        "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
      },
      "vs:term_status": "stable",
      "mentioned": [
        {
          "@id": "https://example.org/v.context.jsonld",
          "@type": "jsonld:Context"
        }
      ]
    },
    {
      "@id": "ex:Author",
      "@type": "rdfs:Class",
      "rdfs:label": "Author",
      "rdfs:comment": {
        "@value": "<div>A person who writes.</div>",
        "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
      },
      "vs:term_status": "stable",
      "mentioned": [
        {
          "@id": "https://example.org/v.context.jsonld",
          "@type": "jsonld:Context"
        }
      ]
    },
    {
      "@id": "ex:Publisher",
      "@type": "rdfs:Class",
      "rdfs:label": "Publisher",
      "rdfs:comment": {
        "@value": "<div>An organization that publishes books.</div>",
        "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
      },
      "vs:term_status": "stable",
      "mentioned": [
        {
          "@id": "https://example.org/v.context.jsonld",
          "@type": "jsonld:Context"
        }
      ]
    }
  ]
}